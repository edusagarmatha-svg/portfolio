NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/portfolio_cms?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=pcms_token
CORS_ORIGIN=http://localhost:5173
# Uploaded media. On Railway, point this at a mounted volume (e.g. /data/uploads).
UPLOAD_DIR=./uploads

# Built SPA served by the API. Relative to the API's working directory.
WEB_DIST_DIR=../web/dist

# Seed admin (dev only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Portfolio Owner